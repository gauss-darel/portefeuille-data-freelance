/* Premier fichier : logistics_international */



CREATE TABLE IF NOT EXISTS public.logistics_international_dirty (
    id_expedition VARCHAR(255),
    code_produit VARCHAR(255),
    code_postal_destination VARCHAR(255),
    pays_destination VARCHAR(255),
    statut_livraison VARCHAR(255)

);

select * FROM public.logistics_international_dirty;

/* suppression securiser des doublons dans le fichier */

DELETE 
from public.logistics_international_dirty 
where ctid not in (
    select min(ctid)
    from public.logistics_international_dirty
    group by id_expedition, code_produit, code_postal_destination, pays_destination, statut_livraison

);

/* reparation des codes postaux francais ( ajout du 0 finale) */

update public.logistics_international_dirty
set code_postal_destination = LPAD(TRIM(code_postal_destination), 5, '0')
where  length(TRIM(code_postal_destination))<5;

/* verification */

select * FROM public.logistics_international_dirty;


/*Harmonisation des pays de destination */

update public.logistics_international_dirty
set pays_destination =case
WHEN lower(TRIM(pays_destination)) = '' OR lower(TRIM(pays_destination)) IN ('null', 'nan') THEN NULL
WHEN lower(TRIM(pays_destination)) = 'fr' THEN 'FRANCE'
else upper(TRIM(pays_destination))
end;

/* verification */

select * FROM public.logistics_international_dirty;


/*Harmonisation des statuts de livraison */

update public.logistics_international_dirty
SET statut_livraison = case
when lower(TRIM(statut_livraison)) = '' OR lower(TRIM(statut_livraison)) IN ('null', 'blank', 'n/a', 'nan') THEN NULL
else upper(TRIM(statut_livraison))
end;

/* verification */

select * FROM public.logistics_international_dirty;


