create TABLE IF NOT EXISTS public.registre_b2b_dirty (
    id_entreprise VARCHAR(255),
    raison_sociale VARCHAR(255),
    numero_siret VARCHAR(255),
    secteur_activite VARCHAR(255)
);

SELECT * FROM public.registre_b2b_dirty;

/* suppression securiser des doublons dans le fichier */

delete 
from public.registre_b2b_dirty
where ctid not in (
    select min(ctid)
    from public.registre_b2b_dirty
    group by id_entreprise, raison_sociale, numero_siret, secteur_activite
);

/* uniformisation de la colonne raison sociale */

update public.registre_b2b_dirty
set raison_sociale = replace(upper(TRIM(raison_sociale)), 'Ã©', 'é');

/* verification */

SELECT * FROM public.registre_b2b_dirty;


update public.registre_b2b_dirty
SET raison_sociale = lower(TRIM(raison_sociale));

SELECT * FROM public.registre_b2b_dirty;

/*suppression des caracteres speciaux dans la colonne numero_siret */

update public.registre_b2b_dirty
set numero_siret = regexp_replace(numero_siret, '[^0-9]', '', 'g');

SELECT * FROM public.registre_b2b_dirty;


/*suppression des numeros invalides */ 

update public.registre_b2b_dirty
set numero_siret = case 
WHEN length(TRIM(numero_siret))> 14 THEN NULL
when length(TRIM(numero_siret))<14 THEN NULL
else TRIM(numero_siret)
end;

SELECT * FROM public.registre_b2b_dirty;

/*nettoyage du champ secteur d'activiter */

update public.registre_b2b_dirty
set secteur_activite = case
when lower(TRIM(secteur_activite)) = '' OR lower(TRIM(secteur_activite)) IN ('null', 'n/a') THEN NULL
ELSE initcap(TRIM(secteur_activite))
end;

SELECT * FROM public.registre_b2b_dirty;

